{
  "extends": "./tsconfig.base.json",
  "compilerOptions": {
    "composite": true,
    "lib": ["ES2023"],
    "types": ["node"]
  },
  "include": [
    "electron.vite.config.mts",
    "vitest.config.mts",
    "playwright.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "src/renderer/lib/format.ts",
    "tests/**/*",
    "scripts/**/*"
  ],
  "exclude": ["tests/unit/journal-store.test.ts"]
}
